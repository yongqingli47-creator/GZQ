{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Python: install research dependencies",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "pip",
        "install",
        "-r",
        "${workspaceFolder}/requirements.txt"
      ],
      "problemMatcher": []
    },
    {
      "label": "PostgreSQL: verify environment",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": [
        "${workspaceFolder}/scripts/postgres_verify.py",
        "--require-postgis"
      ],
      "problemMatcher": []
    },
    {
      "label": "Stata: verify environment",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/stata_exec.sh",
      "args": [
        "-b",
        "do",
        "${workspaceFolder}/scripts/stata_smoke.do"
      ],
      "problemMatcher": []
    },
    {
      "label": "Stata: run current file",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/stata_exec.sh",
      "args": [
        "-b",
        "do",
        "${file}"
      ],
      "problemMatcher": []
    },
    {
      "label": "Zotero: sync metadata snapshot",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": [
        "${workspaceFolder}/scripts/zotero_sync.py"
      ],
      "problemMatcher": []
    }
  ]
}